---
interface Props {
  id: string;
  index: string;
  title: string;
  class?: string;
}

const { id, index, title, class: className } = Astro.props;
---

<section
  id={id}
  class:list={["section", className]}
  aria-labelledby={`${id}-title`}
>
  <header class="section-header">
    <span class="section-index" aria-hidden="true">{index}</span>
    <h2 id={`${id}-title`}>{title}</h2>
  </header>
  <div class="section-content">
    <slot />
  </div>
</section>
